# FARAZZ FLOW API — environment config (copy to .env and adjust)
# All keys are optional; defaults shown below.

NODE_ENV=development

# HTTP
PORT=4100
APP_URL=http://localhost:4100
CORS_ORIGINS=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=farazz_flow

# Sessions & CSRF (MUST be changed in production)
SESSION_TTL_HOURS=12
SESSION_SECRET=change-me-to-a-long-random-string
CSRF_SECRET=change-me-to-a-different-long-random-string

# Auth hardening
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15

# Rate limiting (auth endpoints)
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000

# File uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

# Logging
LOG_LEVEL=info