# ─── FARAZZ FLOW — Environment Configuration ─────────────────────────────
# Copy to .env and adjust for your machine (Laragon default shown).
# NEVER commit .env. This file is git-ignored.

# App
PORT=4100
NODE_ENV=development
APP_URL=http://localhost:4100
# Frontend origins allowed to call the API via CORS (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database — Laragon defaults (root, no password). Adjust as needed.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=farazz_flow

# Session
SESSION_TTL_HOURS=12
# 32+ random hex chars. Generate with: openssl rand -hex 32
SESSION_SECRET=
# CSRF secret used to sign the anti-forgery token (32+ hex chars)
CSRF_SECRET=

# Auth hardening
# Lock account after N failed login attempts, then block for M minutes.
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15
# Rate limiting for auth endpoints (requests per window per IP).
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000

# File uploads (used from Phase 10 onward)
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

# Logging
LOG_LEVEL=info